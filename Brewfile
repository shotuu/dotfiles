# Cross-platform formulae, installable via Homebrew on macOS and Linux.
# macOS-only casks (WezTerm, Nerd Font) live in Brewfile.mac.

# Terminal and shell
brew "tmux"
brew "starship"
brew "zoxide"
brew "fzf"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Modern command-line tools
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "btop"
brew "lazygit"
brew "yazi"

# Neovim and development support
brew "neovim"
brew "git"
brew "stylua"
